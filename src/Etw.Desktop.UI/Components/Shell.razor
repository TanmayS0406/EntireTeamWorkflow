@inherits StateComponent

<div class="shell">
    <header class="topbar">
        <div class="brand">
            <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true"><g stroke="#D97757" stroke-width="3.4" stroke-linecap="round"><path d="M16 3v26M3 16h26M7 7l18 18M25 7L7 25" /></g></svg>
            <span>Entire Team Workflow</span>
        </div>

        <div class="project-switch">
            <select @onchange="OnProjectChanged" aria-label="Project">
                @if (State.Project is null) { <option value="">No project</option> }
                @foreach (var p in State.Projects)
                {
                    <option value="@p.Id" selected="@(p.Id == State.Project?.Id)">@p.Name</option>
                }
            </select>
            <button class="btn small" @onclick="() => _showNew = true">+ New project</button>
        </div>

        <div class="spacer"></div>

        <button class="service-dot" title="@ServiceTooltip" @onclick="State.RefreshServicesAsync">
            <span class="dot @ServiceClass"></span> Services
        </button>

        <div class="account">
            <span class="dot ok"></span>
            <span title="Signed in to Claude">@(State.ClaudeAccount ?? "Claude")</span>
            <button class="btn small" @onclick="State.SignOutAsync">Sign out</button>
        </div>
    </header>

    <nav class="rail">
        @foreach (var (tab, label, path) in Tabs)
        {
            <button class="rail-btn @(State.ActiveTab == tab ? "active" : "")" title="@label" @onclick="() => State.Go(tab)">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="@path" /></svg>
                <span>@label</span>
            </button>
        }
    </nav>

    <main class="content">
        @if (State.BackendError is not null)
        {
            <div class="banner error">
                <span>@State.BackendError</span>
                <button class="btn small" @onclick="State.LoadAllAsync">Retry</button>
            </div>
        }
        else if (State.ClaudeMismatch)
        {
            <div class="banner warn">
                <span>You are signed in to Claude, but the backend service is not — it runs as a different Windows account, so agents cannot start. Reinstall the services with <code>-ServiceUser</code> (see the README).</span>
            </div>
        }

        @switch (State.ActiveTab)
        {
            case Tab.Workflow:
                <WorkflowCanvas OnNewProject="() => _showNew = true" />
                break;
            case Tab.Backlog:
                <BacklogView />
                break;
            case Tab.Runs:
                <RunsView />
                break;
            case Tab.Integrations:
                <IntegrationsView />
                break;
            case Tab.Settings:
                <SettingsView />
                break;
        }
    </main>

    <div class="toasts">
        @foreach (var toast in State.Toasts)
        {
            <div class="toast @(toast.IsError ? "error" : "")">@toast.Message</div>
        }
    </div>

    @if (_showNew)
    {
        <NewProjectDialog OnClose="() => _showNew = false" />
    }
</div>

@code {
    private bool _showNew;

    private static readonly (Tab Tab, string Label, string Path)[] Tabs =
    [
        (Tab.Workflow, "Workflow", "M4 6h5v5H4zM15 4h5v5h-5zM15 15h5v5h-5zM9 8.5h3.5a2 2 0 0 1 2 2V17M9 8.5h3.5a2 2 0 0 0 2-2V6.5"),
        (Tab.Backlog, "Backlog", "M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"),
        (Tab.Runs, "Runs", "M5 4l14 8-14 8z"),
        (Tab.Integrations, "Connect", "M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0zM12 16v5"),
        (Tab.Settings, "Settings", "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"),
    ];

    private string ServiceClass => State.Services.Count == 0 ? "off" : State.Services.All(s => s.Healthy) ? "ok" : "bad";

    private string ServiceTooltip => State.Services.Count == 0
        ? "Service status unknown — click to refresh"
        : string.Join("\n", State.Services.Select(s => $"{s.Name}: {(s.Healthy ? "running" : "not running")}"));

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) await State.SelectProjectSafeAsync(id);
    }
}
